---
import { composer, site } from '../data/content';
---

<div class="composer" data-composer data-email={site.email} data-subject={composer.subject}>
  <div class="box">
    <label class="sr-only" for="compose">Write to Vishnu. This opens your email app; nothing is sent from this site.</label>
    <input
      id="compose"
      type="text"
      placeholder={composer.placeholder}
      autocomplete="off"
      maxlength="1500"
      enterkeyhint="send"
      data-compose-input
    />
    <span class="hint" aria-hidden="true">{composer.hint}</span>
    <button type="button" class="send" data-compose-send>
      <span aria-hidden="true">↑</span><span class="sr-only">Open in your email app</span>
    </button>
  </div>
</div>

<div class="mailhelp" data-mailhelp role="status" hidden>
  <p class="mh-text">Opening your email app. Nothing opened?</p>
  <div class="mh-actions">
    <a class="mh-btn" data-mh-gmail href="https://mail.google.com/" target="_blank" rel="noopener noreferrer">
      Write in Gmail <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
    </a>
    <button type="button" class="mh-btn" data-mh-copy>Copy address</button>
    <button type="button" class="mh-close" data-mh-close>
      <span aria-hidden="true">×</span><span class="sr-only">Dismiss</span>
    </button>
  </div>
</div>

<style>
  .composer {
    position: fixed;
    left: 50%;
    bottom: calc(18px + env(safe-area-inset-bottom));
    z-index: 50;
    width: min(640px, calc(100% - 24px));
    visibility: hidden;
    opacity: 0;
    transform: translate(-50%, 140%);
    transition:
      transform 0.6s var(--ease),
      opacity 0.4s ease,
      visibility 0s linear 0.6s;
  }
  .composer.is-shown {
    visibility: visible;
    opacity: 1;
    transform: translate(-50%, 0);
    transition:
      transform 0.6s var(--ease),
      opacity 0.4s ease,
      visibility 0s;
  }
  :global(html:not(.ready)) .composer {
    display: none;
  }

  .box {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px 8px 8px 20px;
    border-radius: 999px;
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-composer);
  }
  .box:focus-within {
    border-color: var(--accent);
  }

  input {
    flex: 1;
    min-width: 0;
    height: 44px;
    border: 0;
    outline: 0;
    background: transparent;
    font: 400 16px/1 var(--font-sans);
  }
  input::placeholder {
    color: var(--muted);
    opacity: 1;
  }

  .hint {
    font: 400 10.5px/1.2 var(--font-mono);
    color: var(--muted);
    white-space: nowrap;
  }

  /* Narrow phones: stack the hint so the placeholder stays whole. The hint stays visible. */
  @media (max-width: 400px) {
    .box {
      padding-left: 16px;
    }
    .hint {
      white-space: normal;
      width: 6.5em;
      text-align: right;
    }
  }

  /* Fallback when no email app opens: Gmail compose or copy the address. */
  .mailhelp {
    position: fixed;
    left: 50%;
    bottom: calc(86px + env(safe-area-inset-bottom));
    z-index: 51;
    width: min(640px, calc(100% - 24px));
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 14px;
    padding: 12px 12px 12px 20px;
    border-radius: 22px 22px 22px 6px;
    background: var(--guest);
    color: var(--guest-ink);
    box-shadow: var(--shadow-composer);
    transform: translateX(-50%);
    animation: mh-in 0.3s var(--ease);
  }
  .mailhelp[hidden] {
    display: none;
  }

  .mh-text {
    padding-right: 36px;
    font: 500 14px/1.4 var(--font-sans);
  }

  .mh-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .mh-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--guest-ink) 30%, transparent);
    background: transparent;
    color: var(--guest-ink);
    font: 500 13px/1 var(--font-sans);
    white-space: nowrap;
    transition: border-color 0.2s ease;
  }
  .mh-btn:hover {
    border-color: var(--guest-ink);
  }
  .mh-btn:focus-visible,
  .mh-close:focus-visible {
    outline-color: var(--guest-ink);
  }

  .mh-close {
    position: absolute;
    top: 2px;
    right: 2px;
    width: 44px;
    height: 44px;
    flex: none;
    border: 0;
    border-radius: 50%;
    background: transparent;
    color: var(--guest-ink);
    font: 400 22px/1 var(--font-sans);
  }

  @keyframes mh-in {
    from {
      opacity: 0;
      transform: translate(-50%, 10px);
    }
  }

  .send {
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    border: 0;
    background: var(--accent-fill);
    color: var(--on-accent);
    font: 500 18px/1 var(--font-sans);
    transition: transform 0.2s var(--ease);
  }
  .send:hover {
    transform: scale(1.08);
  }
  .send:active {
    transform: scale(0.96);
  }
</style>
