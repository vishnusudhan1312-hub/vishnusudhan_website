---
import { build } from '../data/content';
---

<figure class="build card attach" data-reveal="card">
  <figcaption class="head meta">
    <span>{build.name}</span><span>{build.label}</span>
  </figcaption>
  <ol class="steps">
    {
      build.steps.map((s) => (
        <li class:list={['step', { live: !s.done }]}>
          <span class="ico" aria-hidden="true">
            {s.done === 1 ? '✓' : s.done === 2 ? '✓✓' : ''}
          </span>
          <span class="nm">{s.name}</span>
          <span class="st">{s.state}</span>
        </li>
      ))
    }
  </ol>
  <div class="bar" aria-hidden="true"><span></span></div>
</figure>

<style>
  .build {
    max-width: 480px;
    padding: 20px 22px;
  }

  .head {
    display: flex;
    gap: 16px;
    justify-content: space-between;
    margin-bottom: 16px;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .step {
    display: grid;
    grid-template-columns: 36px 1fr auto;
    align-items: center;
  }

  .ico {
    font: 500 14px/1 var(--font-sans);
    color: var(--accent);
    letter-spacing: -3px;
  }
  .live .ico {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: blink 1.4s infinite;
  }

  .nm {
    font: 500 15px/1 var(--font-sans);
  }

  .st {
    font: 400 11px/1 var(--font-mono);
    color: var(--muted);
  }
  .live .st {
    color: var(--accent);
    animation: blink 1.4s infinite;
  }

  .bar {
    position: relative;
    height: 3px;
    margin-top: 18px;
    border-radius: 3px;
    background: var(--line);
    overflow: hidden;
  }
  .bar span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 40%;
    background: var(--accent);
    animation: shimmer 1.6s linear infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0.3;
    }
  }
  @keyframes shimmer {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(260%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bar span {
      transform: none;
    }
  }
</style>
