---
import { Picture } from 'astro:assets';
import headshot from '../assets/headshot-square.jpg';
import { site } from '../data/content';
---

<header class="bar">
  <div class="who">
    <Picture
      src={headshot}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[88, 176]}
      sizes="44px"
      width={44}
      height={44}
      alt="Vishnu Sudhan"
      class="face"
      loading="eager"
      fetchpriority="low"
    />
    <div class="id">
      <p class="name">{site.name}</p>
      <p class="status">
        <span data-status>online</span> · <span class="city">{site.city} </span><span data-clock></span> IST
      </p>
    </div>
  </div>
  <div class="actions">
    <button class="pill toggle" type="button" data-theme-toggle>
      <span class="moon" aria-hidden="true"></span>
      <span class="lbl"><span class="to-dark">Dark</span><span class="to-light">Light</span> <span class="sr-only">theme</span></span>
    </button>
    <a class="pill solid" href={site.linkedin} target="_blank" rel="noopener noreferrer">
      <span class="li-full">LinkedIn</span><span class="li-short" aria-hidden="true">in</span>
      <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
    </a>
  </div>
</header>

<style>
  .bar {
    position: sticky;
    top: 0;
    z-index: 40;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: var(--header-h);
    padding: 0 clamp(16px, 4vw, 36px);
    padding-left: max(clamp(16px, 4vw, 36px), env(safe-area-inset-left));
    padding-right: max(clamp(16px, 4vw, 36px), env(safe-area-inset-right));
    background: var(--chip);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line);
  }

  .who {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }

  .who :global(.face) {
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    object-fit: cover;
    filter: grayscale(1);
    transition: filter 0.4s var(--ease);
  }
  .who :global(.face):hover {
    filter: grayscale(0);
  }

  .id {
    min-width: 0;
  }

  .name {
    font: 600 15px/1.2 var(--font-sans);
    letter-spacing: -0.01em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .status {
    font: 400 12px/1.3 var(--font-mono);
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  [data-status] {
    transition: color var(--t-std) ease;
  }
  :global(.is-typing) [data-status] {
    color: var(--accent);
  }

  [data-clock]:empty {
    display: none;
  }

  .actions {
    display: flex;
    align-items: center;
    gap: 8px;
    flex: none;
  }

  .pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 44px;
    padding: 0 16px;
    border-radius: 999px;
    font: 500 13px/1 var(--font-sans);
    white-space: nowrap;
  }

  .toggle {
    border: 1px solid var(--line);
    background: transparent;
    color: var(--ink);
    transition: border-color 0.2s ease;
  }
  .toggle:hover {
    border-color: var(--accent);
  }
  :global(html:not(.ready)) .toggle {
    visibility: hidden;
  }

  .moon {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--ink);
    box-shadow: inset -3px -2px 0 var(--bg);
  }

  .to-light,
  :global([data-theme='dark']) .to-dark {
    display: none;
  }
  :global([data-theme='dark']) .to-light {
    display: inline;
  }

  .li-short {
    display: none;
  }

  .solid {
    background: var(--ink);
    color: var(--bg);
    transition: opacity 0.2s ease;
  }
  .solid:hover {
    opacity: 0.86;
  }

  /* Phones: icon-only theme toggle and a shorter status line so name and clock stay whole. */
  @media (max-width: 420px) {
    .bar {
      gap: 10px;
    }
    .pill {
      padding: 0 13px;
    }
    .toggle {
      width: 44px;
      padding: 0;
      justify-content: center;
    }
    .lbl {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .status {
      font-size: 11px;
    }
    :global(.ready) .city {
      display: none;
    }
  }

  @media (max-width: 389px) {
    .bar {
      gap: 8px;
    }
    .who {
      gap: 10px;
    }
    .actions {
      gap: 6px;
    }
    .pill {
      padding: 0 12px;
      gap: 4px;
    }
    .li-full {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .li-short {
      display: inline;
    }
  }
</style>
