---
import { certificates } from '../data/content';
---

<ul class="certs attach" data-fan>
  {
    certificates.map((c) => (
      <li class="cert" data-fan-item>
        <span class="doc" aria-hidden="true">
          CERT
        </span>
        <div class="body">
          <p class="name">{c.name}</p>
          <p class="note">{c.note}</p>
        </div>
      </li>
    ))
  }
</ul>

<style>
  .certs {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .cert {
    position: relative;
    display: flex;
    gap: 14px;
    align-items: flex-start;
    max-width: 560px;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--r-card-sm) var(--r-card-sm) var(--r-card-sm) var(--r-tail);
    box-shadow: 0 20px 34px -28px rgba(0, 0, 0, 0.5);
  }
  .cert:nth-child(1) { z-index: 10; }
  .cert:nth-child(2) { z-index: 9; }
  .cert:nth-child(3) { z-index: 8; }
  .cert:nth-child(4) { z-index: 7; }

  .doc {
    flex: none;
    width: 38px;
    height: 46px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 6px;
    background: var(--accent-fill);
    clip-path: polygon(0 0, 70% 0, 100% 24%, 100% 100%, 0 100%);
    font: 500 9px/1 var(--font-mono);
    letter-spacing: 0.05em;
    color: var(--on-accent);
  }

  .body {
    min-width: 0;
  }
  .name {
    font: 600 14.5px/1.3 var(--font-sans);
  }
  .note {
    margin-top: 3px;
    font: 400 13.5px/1.5 var(--font-sans);
    color: var(--muted);
  }
</style>
