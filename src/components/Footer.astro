---
import { footer } from '../data/content';
---

<footer class="foot col">
  <p class="sign">{footer.lead} <em>{footer.close}</em></p>
  <p class="edu">{footer.line}</p>
</footer>

<style>
  .foot {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 120px;
  }
  .foot::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: 18px;
    background: var(--line);
  }

  .sign {
    font: 400 clamp(2rem, 6vw, 3.4rem) / 1 var(--font-serif);
    text-wrap: balance;
  }
  .sign em {
    color: var(--accent);
  }

  .edu {
    font: 400 12.5px/1.6 var(--font-mono);
    color: var(--muted);
  }
</style>
