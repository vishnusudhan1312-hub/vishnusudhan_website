---
import { flips } from '../data/content';
---

<ul class="flips attach" data-reveal="card">
  {
    flips.map((f, i) => (
      <li class:list={['flip', { rev: i % 2 === 1 }]} data-flip>
        <div class="inner">
          <div class="face front">
            <p class="lab">{f.label}</p>
            <h3 class="ft">{f.front}</h3>
            <p class="hint" aria-hidden="true">
              Tap to flip ↻
            </p>
          </div>
          <div class="face back">
            <p class="lab">What I did</p>
            <p class="bt">{f.back}</p>
          </div>
        </div>
        <button type="button" class="flip-btn" aria-pressed="false">
          <span class="sr-only">Flip: {f.front}</span>
        </button>
      </li>
    ))
  }
</ul>

<style>
  .flips {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 14px;
  }

  .flip {
    position: relative;
    perspective: 1200px;
    --turn: 180deg;
  }
  .flip.rev {
    --turn: -180deg;
  }

  .inner {
    display: grid;
    min-height: 250px;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.8s var(--ease);
  }
  .flip.is-flipped .inner {
    transform: rotateY(var(--turn));
  }

  .face {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 22px;
    border-radius: var(--r-card);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  .front {
    background: var(--card);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-flip);
  }
  .back {
    justify-content: space-between;
    background: var(--guest);
    color: var(--guest-ink);
    transform: rotateY(180deg);
    --lab: var(--accent-on-guest);
  }

  .lab {
    font: 500 10.5px/1.2 var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lab, var(--accent));
  }

  .ft {
    margin-top: auto;
    font: 400 34px/1.02 var(--font-serif);
    text-wrap: balance;
  }

  .hint {
    font: 500 12px/1 var(--font-sans);
    color: var(--muted);
  }

  .bt {
    font: 400 15px/1.55 var(--font-sans);
    text-wrap: pretty;
  }

  .flip-btn {
    position: absolute;
    inset: 0;
    z-index: 2;
    border: 0;
    border-radius: var(--r-card);
    background: transparent;
  }

  /* No JS: nothing to flip with, so show both sides stacked. */
  :global(html:not(.js)) .inner {
    display: flex;
    flex-direction: column;
    gap: 10px;
    transform: none;
  }
  :global(html:not(.js)) .face {
    -webkit-backface-visibility: visible;
    backface-visibility: visible;
  }
  :global(html:not(.js)) .back {
    transform: none;
  }
  :global(html:not(.js)) .flip-btn,
  :global(html:not(.js)) .hint {
    display: none;
  }

  /* Reduced motion: swap sides without rotating. */
  @media (prefers-reduced-motion: reduce) {
    .flip.is-flipped .inner {
      transform: none;
    }
    .face {
      -webkit-backface-visibility: visible;
      backface-visibility: visible;
    }
    .back {
      transform: none;
      opacity: 0;
    }
    .flip.is-flipped .back {
      opacity: 1;
    }
    .flip.is-flipped .front {
      opacity: 0;
    }
  }
</style>
