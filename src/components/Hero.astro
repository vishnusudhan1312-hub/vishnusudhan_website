---
import { hero, chips } from '../data/content';

// [parallax depth, accent]. Start positions, rotations and sizes live in the .m1–.m14 rules below.
const marks: [number, 0 | 1][] = [
  [1.2, 1], [0.6, 0], [0.9, 0], [1.4, 1], [0.4, 0], [1.0, 0], [0.3, 1],
  [0.5, 0], [0.2, 0], [0.25, 1], [1.6, 0], [0.7, 1], [0.15, 0], [0.3, 0],
];
const last = hero.line2.length - 1;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="marks" aria-hidden="true">
    {
      marks.map(([depth, accent], i) => (
        <span class={`mark m${i + 1}`} data-depth={depth}>
          <span class:list={['q', { acc: accent, deep: depth < 0.35 }]}>?</span>
        </span>
      ))
    }
  </div>

  <p class="eyebrow">{hero.eyebrow}</p>

  <h1 id="hero-title" class="title">
    <span class="line">
      {hero.line1.map((w) => <Fragment><span class="w">{w}</span>{' '}</Fragment>)}
    </span>
    <span class="line l2">
      {
        hero.line2.map((w, i) => (
          <Fragment>
            <span class:list={['w', { acc: i === last }]}>{w}</span>
            {i < last ? ' ' : ''}
          </Fragment>
        ))
      }
    </span>
  </h1>

  <nav class="ask" aria-labelledby="ask-label">
    <p id="ask-label" class="ask-label">{hero.chipsLabel}</p>
    <ul class="chips">
      {
        chips.map((c) => (
          <li>
            <a class="chip" href={`#${c.id}`} data-jump>
              {c.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</section>

<style>
  .hero {
    position: relative;
    min-height: calc(100vh - var(--header-h));
    min-height: calc(100svh - var(--header-h));
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 72px clamp(20px, 5vw, 48px) 96px;
    overflow: hidden;
    isolation: isolate;
  }

  .marks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    display: none;
  }

  .mark {
    position: absolute;
    left: 50%;
    top: 44%;
    will-change: transform;
  }

  .q {
    display: block;
    font-family: var(--font-serif);
    line-height: 1;
    color: var(--ink);
    opacity: 0.9;
    font-size: var(--s);
    transform: translate(calc(-50% + var(--x)), calc(-50% + var(--y))) rotate(var(--r));
  }
  .q.acc {
    color: var(--accent);
  }
  .q.deep {
    opacity: 0.35;
    filter: blur(2px);
  }

  .m1 { --x: -40vw; --y: -28vh; --r: -18deg; --s: 96px; }
  .m2 { --x: 36vw; --y: -30vh; --r: 14deg; --s: 130px; }
  .m3 { --x: -31vw; --y: 24vh; --r: 22deg; --s: 72px; }
  .m4 { --x: 41vw; --y: 22vh; --r: -10deg; --s: 104px; }
  .m5 { --x: -9vw; --y: -36vh; --r: 6deg; --s: 56px; }
  .m6 { --x: 13vw; --y: 32vh; --r: -20deg; --s: 84px; }
  .m7 { --x: -46vw; --y: 2vh; --r: 30deg; --s: 50px; }
  .m8 { --x: 46vw; --y: -6vh; --r: -28deg; --s: 62px; }
  .m9 { --x: -21vw; --y: -12vh; --r: 12deg; --s: 40px; }
  .m10 { --x: 24vw; --y: -18vh; --r: -8deg; --s: 46px; }
  .m11 { --x: -25vw; --y: 38vh; --r: -14deg; --s: 118px; }
  .m12 { --x: 30vw; --y: 40vh; --r: 18deg; --s: 54px; }
  .m13 { --x: 5vw; --y: -24vh; --r: 40deg; --s: 36px; }
  .m14 { --x: -5vw; --y: 22vh; --r: -36deg; --s: 44px; }

  .eyebrow,
  .ask-label {
    position: relative;
    font: 500 12px/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-align: center;
  }
  .eyebrow {
    margin-bottom: 28px;
  }

  .title {
    position: relative;
    max-width: 1100px;
    text-align: center;
    font: 400 clamp(3rem, 10vw, 8.4rem) / 0.94 var(--font-serif);
    letter-spacing: -0.02em;
    text-wrap: balance;
    perspective: 900px;
  }

  .line {
    display: block;
  }
  .l2 {
    font-style: italic;
  }

  .w {
    display: inline-block;
  }
  .w.acc {
    color: var(--accent);
  }

  .ask {
    position: relative;
    margin-top: 56px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
  }
  .ask-label {
    font-size: 11px;
    letter-spacing: 0.12em;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
    max-width: 760px;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px 999px var(--r-tail) 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    font: 500 14px/1 var(--font-sans);
    box-shadow: 0 1px 0 var(--line);
    transition:
      transform 0.2s var(--ease),
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }
  .chip:hover {
    transform: translateY(-2px);
    border-color: var(--accent);
    box-shadow: var(--chip-hover-shadow);
  }

  @media (max-width: 420px) {
    .chip {
      font-size: 13px;
      padding: 0 15px;
    }
  }

  @media (max-width: 359px) {
    .chip {
      white-space: normal;
      text-align: left;
      line-height: 1.3;
      padding-block: 10px;
    }
  }

  /* Load sequence. Pure CSS so it starts at first paint, not when scripts arrive. */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .marks {
      display: block;
    }
    :global(.js) .q {
      animation: converge 1.3s var(--ease) 80ms both;
    }
    :global(.js) .w {
      animation: word-in 1s var(--ease) both;
    }
    :global(.js) .line:first-child .w:nth-child(1) { animation-delay: 750ms; }
    :global(.js) .line:first-child .w:nth-child(2) { animation-delay: 830ms; }
    :global(.js) .line:first-child .w:nth-child(3) { animation-delay: 910ms; }
    :global(.js) .l2 .w:nth-child(1) { animation-delay: 1050ms; }
    :global(.js) .l2 .w:nth-child(2) { animation-delay: 1130ms; }
    :global(.js) .l2 .w:nth-child(3) { animation-delay: 1210ms; }
    :global(.js) .l2 .w:nth-child(4) { animation-delay: 1290ms; }
    :global(.js) .eyebrow {
      animation: fade-in 0.8s ease 1.4s both;
    }
    :global(.js) .ask {
      animation: rise-in 0.8s var(--ease) 1.6s both;
    }
  }

  @keyframes converge {
    to {
      transform: translate(-50%, -50%) scale(0.2) rotate(0deg);
      opacity: 0;
      filter: none;
    }
  }
  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(30px) rotateX(-40deg);
      filter: blur(12px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }
  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
</style>
