---
import '../styles/global.css';
import serifUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-normal.woff2?url';
import serifItalicUrl from '@fontsource/instrument-serif/files/instrument-serif-latin-400-italic.woff2?url';
import interUrl from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import { site, faqAnswers } from '../data/content';

const canonical = new URL('/', site.url).href;
const ogImage = new URL('/og-image.png', site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${canonical}#person`,
      name: site.name,
      jobTitle: site.jobTitle,
      worksFor: { '@type': 'Organization', name: site.org },
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.city,
        addressRegion: 'Tamil Nadu',
        addressCountry: 'IN',
      },
      url: site.url,
      email: `mailto:${site.email}`,
      image: ogImage,
      sameAs: [site.linkedin],
      alumniOf: [
        { '@type': 'CollegeOrUniversity', name: 'Loyola College' },
        { '@type': 'CollegeOrUniversity', name: 'Bharathiar University' },
      ],
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonical}#faq`,
      about: { '@id': `${canonical}#person` },
      mainEntity: faqAnswers().map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};

// Escape "<" so no string in the data can close the script element.
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{site.title}</title>
    <meta name="description" content={site.description} />
    <meta name="author" content={site.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbf7f2" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0d0c" media="(prefers-color-scheme: dark)" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="canonical" href={canonical} />

    <link rel="preload" href={serifUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifItalicUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={site.title} />
    <meta property="og:description" content={site.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Understand the goal. Then do the work. Vishnu Sudhan, Partnerships and Alliances." />
    <meta property="og:locale" content="en_IN" />
    <meta property="profile:first_name" content="Vishnu" />
    <meta property="profile:last_name" content="Sudhan" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={site.title} />
    <meta name="twitter:description" content={site.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="me" href={site.linkedin} />

    <script is:inline src="/theme-init.js"></script>
    <script type="application/ld+json" set:html={jsonLdText} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to the conversation</a>
    <slot />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
