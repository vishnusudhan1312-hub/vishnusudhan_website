---
import '../styles/global.css';
import { site } from '../data/content';
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Page not found · {site.name}</title>
    <meta name="robots" content="noindex" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <main class="nf">
      <p class="q">Is this page still here?</p>
      <p class="a">No. It may have moved, or the link has a typo.</p>
      <a class="home" href="/">Back to the conversation</a>
    </main>
  </body>
</html>

<style>
  .nf {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 14px;
    max-width: 560px;
    margin: 0 auto;
    padding: 24px;
  }
  .q {
    align-self: flex-end;
    background: var(--guest);
    color: var(--guest-ink);
    font: 500 16px/1.45 var(--font-sans);
    padding: 12px 17px;
    border-radius: 22px 22px 6px 22px;
  }
  .a {
    align-self: flex-start;
    background: var(--card);
    border: 1px solid var(--line);
    font: 400 17px/1.62 var(--font-sans);
    padding: 15px 19px;
    border-radius: 22px 22px 22px 6px;
  }
  .home {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--accent-fill);
    color: var(--on-accent);
    font: 500 14px/1 var(--font-sans);
  }
</style>
